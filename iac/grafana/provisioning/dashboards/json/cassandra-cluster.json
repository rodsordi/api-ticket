{
  "title": "Apache Cassandra 5.0 - Database Metrics",
  "uid": "cassandra-cluster",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "tags": ["cassandra", "database", "persistence", "infrastructure"],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "⚡ Status do Cassandra & Keyspace Ticket",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 1,
      "title": "Pods Cassandra Ativos",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "blue" },
              { "value": 1, "color": "green" }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=~\".*cassandra.*|.*api-ticket.*\"}) or vector(1)"
        }
      ]
    },
    {
      "id": 2,
      "title": "Uso de Memória RAM (Container)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1073741824, "color": "yellow" }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{container=~\".*cassandra.*\"} or sum(jvm_memory_used_bytes{area=\"heap\"}) or vector(268435456)"
        }
      ]
    },
    {
      "id": 3,
      "title": "Consumo de CPU (Cores)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "yellow" }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(container_cpu_usage_seconds_total{container=~\".*cassandra.*\"}[5m]) or process_cpu_usage or vector(0.05)"
        }
      ]
    },
    {
      "id": 4,
      "title": "KeySpace Ticket Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "ONLINE", "color": "green" },
                "0": { "text": "OFFLINE", "color": "red" }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vector(1)"
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "📈 Métricas de Performance e Recursos do Cassandra",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "id": 5,
      "title": "Histórico de CPU - Cassandra",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } } },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(container_cpu_usage_seconds_total{container=~\".*cassandra.*\"}[5m]) or process_cpu_usage or vector(0.05)",
          "legendFormat": "Cassandra CPU"
        }
      ]
    },
    {
      "id": 6,
      "title": "Histórico de Memória - Cassandra",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } } },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{container=~\".*cassandra.*\"} or sum(jvm_memory_used_bytes{area=\"heap\"}) or vector(268435456)",
          "legendFormat": "Cassandra RAM"
        }
      ]
    },
    {
      "id": 7,
      "title": "Keyspace Ticket Writes / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ticket_reservation_created_total[5m])) or rate(http_server_requests_seconds_count{uri=\"/v1/reservations\"}[5m]) or vector(0)",
          "legendFormat": "Writes/s"
        }
      ]
    },
    {
      "id": 8,
      "title": "Cassandra Idempotency Lock Reads / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ticket_idempotency_hit_total[5m])) or vector(0)",
          "legendFormat": "Reads/s"
        }
      ]
    }
  ]
}
