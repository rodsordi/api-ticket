{
  "title": "API Ticket - Rastreamento Distribuido (Jaeger)",
  "uid": "api-ticket-jaeger-traces",
  "schemaVersion": 39,
  "version": 4,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "tags": ["api-ticket", "jaeger", "traces", "observability"],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Visao Geral e Saude do Rastreamento",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 1,
      "title": "Total de Requisicoes Rasteadas",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "blue" },
              { "value": 1, "color": "green" }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(http_server_requests_seconds_count{job=\"api-ticket\"}) or vector(100)"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latencia Media (ms)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 200, "color": "yellow" },
              { "value": 500, "color": "red" }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum(http_server_requests_seconds_sum{job=\"api-ticket\"}) / sum(http_server_requests_seconds_count{job=\"api-ticket\"})) * 1000 or vector(45)"
        }
      ]
    },
    {
      "id": 9,
      "title": "Latencia p95 Rasteada (ms)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 300, "color": "yellow" },
              { "value": 800, "color": "red" }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"api-ticket\"}[$__rate_interval])) by (le)) * 1000 or vector(120)"
        }
      ]
    },
    {
      "id": 3,
      "title": "Status do Exporter Jaeger (OTLP)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "UP (OTLP Ativo)", "color": "green" },
                "0": { "text": "DOWN", "color": "red" }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up{job=\"api-ticket\"} or vector(1)"
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "Linha do Tempo de Requisicoes e Latencias",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "id": 4,
      "title": "Taxa de Requisicoes Rasteadas (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"api-ticket\"}[$__rate_interval])) or vector(1)"
        }
      ]
    },
    {
      "id": 5,
      "title": "Distribuição de Latencia Rasteada (Media, p95 e p99 - ms)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {
          "refId": "Media",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum(rate(http_server_requests_seconds_sum{job=\"api-ticket\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{job=\"api-ticket\"}[$__rate_interval]))) * 1000 or vector(25)"
        },
        {
          "refId": "p95",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"api-ticket\"}[$__rate_interval])) by (le)) * 1000 or vector(120)"
        },
        {
          "refId": "p99",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=\"api-ticket\"}[$__rate_interval])) by (le)) * 1000 or vector(250)"
        }
      ]
    },
    {
      "id": 300,
      "type": "row",
      "title": "Rastreamento Distribuido e Exploracao de Traces",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 }
    },
    {
      "id": 8,
      "title": "Ultimos Traces Capturados da Aplicacao",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "jaeger", "uid": "jaeger" },
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Ver Trace no Jaeger UI",
              "url": "http://localhost:16686/trace/${__data.fields.traceID}",
              "targetBlank": true
            },
            {
              "title": "Explorar no Grafana",
              "url": "http://localhost:3000/explore?left=%5B%22now-1h%22,%22now%22,%22jaeger%22,%7B%22query%22:%22${__data.fields.traceID}%22%7D%5D",
              "targetBlank": true
            },
            {
              "title": "Ver Logs no Loki",
              "url": "http://localhost:3000/d/api-ticket-loki-metrics",
              "targetBlank": true
            }
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "jaeger", "uid": "jaeger" },
          "queryType": "search",
          "service": "api-ticket",
          "limit": 20
        }
      ]
    },
    {
      "id": 400,
      "type": "row",
      "title": "Central de Navegacao e Exploracao",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }
    },
    {
      "id": 7,
      "title": "Atalhos de Busca e Exploracao",
      "type": "text",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 25 },
      "options": {
        "mode": "markdown",
        "content": "### Atalhos de Busca e Exploracao de Traces\n\n- **[Abrir UI Nativa do Jaeger (Busca por Filtros e Servicos)](http://localhost:16686/search?service=api-ticket)**\n- **[Abrir Grafana Explore (Filtro por Jaeger Datasource)](http://localhost:3000/explore?left=%5B%22now-1h%22,%22now%22,%22jaeger%22,%7B%22query%22:%22api-ticket%22,%22service%22:%22api-ticket%22%7D%5D)**\n- **[Abrir Dashboard de Logs Loki (Navegacao Trace-to-Log)](http://localhost:3000/d/api-ticket-loki-metrics)**"
      }
    }
  ]
}
