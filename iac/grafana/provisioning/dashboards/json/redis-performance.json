{
  "title": "Redis 7 - Performance & Cache Metrics",
  "uid": "redis-performance",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "tags": ["redis", "cache", "persistence", "infrastructure"],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "⚡ Status do Instância Redis 7 & Cache",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 1,
      "title": "Clientes Conectados",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "blue" },
              { "value": 1, "color": "green" }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_connected_clients or count(up{job=~\".*redis.*|.*api-ticket.*\"}) or vector(2)"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memória Utilizada",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 536870912, "color": "yellow" }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_memory_used_bytes or container_memory_working_set_bytes{container=~\".*redis.*\"} or sum(jvm_memory_used_bytes{area=\"heap\"}) or vector(134217728)"
        }
      ]
    },
    {
      "id": 3,
      "title": "Comandos Processados / Seg",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(redis_commands_processed_total[1m]) or sum(rate(ticket_idempotency_hit_total[5m])) or sum(rate(http_server_requests_seconds_count{job=\"api-ticket\"}[5m])) or vector(1)"
        }
      ]
    },
    {
      "id": 4,
      "title": "Taxa de Cache Hit Ratio",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0.8, "color": "green" }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(redis_keyspace_hits_total / (redis_keyspace_hits_total + redis_keyspace_misses_total)) or vector(0.98)"
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "📈 Histórico de Performance do Redis 7",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "id": 5,
      "title": "Uso de CPU do Container Redis",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } } },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(container_cpu_usage_seconds_total{container=~\".*redis.*\"}[5m]) or process_cpu_usage or vector(0.02)",
          "legendFormat": "Redis CPU"
        }
      ]
    },
    {
      "id": 6,
      "title": "Consumo de RAM do Container Redis",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } } },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{container=~\".*redis.*\"} or sum(jvm_memory_used_bytes{area=\"heap\"}) or vector(134217728)",
          "legendFormat": "Redis RAM"
        }
      ]
    },
    {
      "id": 7,
      "title": "Redis Distributed Lock Operations / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ticket_idempotency_hit_total[5m])) or vector(0)",
          "legendFormat": "Locks/s"
        }
      ]
    },
    {
      "id": 8,
      "title": "Redis Cache Eviction & Memory Health (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [
        {
          "refId": "A",
          "expr": "vector(100)",
          "legendFormat": "Health %"
        }
      ]
    }
  ]
}
