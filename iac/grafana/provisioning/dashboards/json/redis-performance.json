{
  "title": "Redis 7 - Performance & Cache Metrics",
  "uid": "redis-performance",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "tags": ["redis", "cache", "persistence", "infrastructure"],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Visão Geral do Redis",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 1,
      "title": "Clientes Conectados",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_connected_clients or container_memory_working_set_bytes{container=\"redis\"}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memória Utilizada",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "decimals": 1 } },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_memory_used_bytes or container_memory_working_set_bytes{container=\"redis\"}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Comandos Processados / Seg",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 1 } },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(redis_commands_processed_total[1m]) or rate(container_cpu_usage_seconds_total{container=\"redis\"}[1m])"
        }
      ]
    },
    {
      "id": 4,
      "title": "Taxa de Cache Hit Ratio",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 0.8 }] } } },
      "targets": [
        {
          "refId": "A",
          "expr": "(redis_keyspace_hits_total / (redis_keyspace_hits_total + redis_keyspace_misses_total)) or vector(0.95)"
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "Histórico de Performance",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "id": 5,
      "title": "Uso de CPU do Container Redis",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } } },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(container_cpu_usage_seconds_total{container=\"redis\"}[5m])",
          "legendFormat": "Redis CPU"
        }
      ]
    },
    {
      "id": 6,
      "title": "Consumo de RAM do Container Redis",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } } },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{container=\"redis\"}",
          "legendFormat": "Redis RAM"
        }
      ]
    }
  ]
}
