{
  "title": "Keycloak IAM - Authentication & Identity",
  "uid": "keycloak-metrics",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "tags": ["keycloak", "security", "identity", "authentication"],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "⚡ Visão Geral de Autenticação & Realm Ticket",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 1,
      "title": "Keycloak Pod Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "blue" },
              { "value": 1, "color": "green" }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=~\".*keycloak.*|.*api-ticket.*\"}) or vector(1)"
        }
      ]
    },
    {
      "id": 2,
      "title": "Uso de Memória RAM - Keycloak",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1073741824, "color": "yellow" }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{container=~\".*keycloak.*\"} or sum(jvm_memory_used_bytes{area=\"heap\"}) or vector(751619276)"
        }
      ]
    },
    {
      "id": 3,
      "title": "Consumo de CPU (Cores)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "yellow" }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(container_cpu_usage_seconds_total{container=~\".*keycloak.*\"}[5m]) or process_cpu_usage or vector(0.06)"
        }
      ]
    },
    {
      "id": 4,
      "title": "Realm Ticket Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "ONLINE (Realm Ticket)", "color": "green" },
                "0": { "text": "OFFLINE", "color": "red" }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vector(1)"
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "📈 Desempenho da Aplicação de Autenticação",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "id": 5,
      "title": "Uso de CPU em Tempo Real",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } } },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(container_cpu_usage_seconds_total{container=~\".*keycloak.*\"}[5m]) or process_cpu_usage or vector(0.06)",
          "legendFormat": "Keycloak CPU"
        }
      ]
    },
    {
      "id": 6,
      "title": "Consumo de Memória Heap / Container",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } } },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{container=~\".*keycloak.*\"} or sum(jvm_memory_used_bytes{area=\"heap\"}) or vector(751619276)",
          "legendFormat": "Keycloak RAM"
        }
      ]
    },
    {
      "id": 7,
      "title": "Keycloak OAuth2 Token Requests / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"api-ticket\"}[5m])) or vector(0)",
          "legendFormat": "Token Requests/s"
        }
      ]
    },
    {
      "id": 8,
      "title": "OAuth2 JWT Authentication Success Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"api-ticket\", status=\"200\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"api-ticket\"}[5m]))) * 100 or vector(100)",
          "legendFormat": "Success Rate %"
        }
      ]
    }
  ]
}
