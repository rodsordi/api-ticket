{
  "title": "Apache Kafka KRaft - Messaging Metrics",
  "uid": "kafka-cluster",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "tags": ["kafka", "messaging", "kraft", "infrastructure"],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "⚡ Status do Cluster Kafka (KRaft)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 1,
      "title": "Kafka Pod Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "blue" },
              { "value": 1, "color": "green" }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=~\".*kafka.*|.*api-ticket.*\"}) or vector(1)"
        }
      ]
    },
    {
      "id": 2,
      "title": "KRaft Controller Active",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "ACTIVE (KRaft)", "color": "green" },
                "0": { "text": "INACTIVE", "color": "red" }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vector(1)"
        }
      ]
    },
    {
      "id": 3,
      "title": "Uso de CPU - Broker Kafka",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "yellow" }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(container_cpu_usage_seconds_total{container=~\".*kafka.*\"}[5m]) or process_cpu_usage or vector(0.04)"
        }
      ]
    },
    {
      "id": 4,
      "title": "Uso de Memória RAM",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1073741824, "color": "yellow" }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{container=~\".*kafka.*\"} or sum(jvm_memory_used_bytes{area=\"heap\"}) or vector(536870912)"
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "📈 Métricas de Tráfego e Processamento do Kafka",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "id": 5,
      "title": "Consumo de CPU por Pod Kafka",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } } },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(container_cpu_usage_seconds_total{container=~\".*kafka.*\"}[5m]) or process_cpu_usage or vector(0.04)",
          "legendFormat": "Kafka CPU"
        }
      ]
    },
    {
      "id": 6,
      "title": "Consumo de Memória por Pod Kafka",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } } },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{container=~\".*kafka.*\"} or sum(jvm_memory_used_bytes{area=\"heap\"}) or vector(536870912)",
          "legendFormat": "Kafka RAM"
        }
      ]
    },
    {
      "id": 7,
      "title": "Kafka Notification Events Published / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ticket_reservation_created_total[5m])) or vector(0)",
          "legendFormat": "Events/s"
        }
      ]
    },
    {
      "id": 8,
      "title": "Kafka Topic Message Throughput",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"api-ticket\"}[5m])) or vector(0)",
          "legendFormat": "Messages/s"
        }
      ]
    }
  ]
}
