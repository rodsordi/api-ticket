{
  "title": "Apache Kafka KRaft - Messaging Metrics",
  "uid": "kafka-cluster",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "tags": ["kafka", "messaging", "kraft", "infrastructure"],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Status do Cluster Kafka (KRaft)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 1,
      "title": "Kafka Pod Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "targets": [
        {
          "refId": "A",
          "expr": "count(kube_pod_status_ready{condition=\"true\", pod=~\"kafka.*\"})"
        }
      ]
    },
    {
      "id": 2,
      "title": "KRaft Controller Active",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }] } } },
      "targets": [
        {
          "refId": "A",
          "expr": "vector(1)"
        }
      ]
    },
    {
      "id": 3,
      "title": "Uso de CPU - Broker Kafka",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 2 } },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(container_cpu_usage_seconds_total{container=\"kafka\"}[5m])"
        }
      ]
    },
    {
      "id": 4,
      "title": "Uso de Memória RAM",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "decimals": 1 } },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{container=\"kafka\"}"
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "Métricas de Tráfego e Processamento",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "id": 5,
      "title": "Consumo de CPU por Pod Kafka",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } } },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(container_cpu_usage_seconds_total{container=\"kafka\"}[5m])",
          "legendFormat": "Kafka CPU"
        }
      ]
    },
    {
      "id": 6,
      "title": "Consumo de Memória por Pod Kafka",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } } },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{container=\"kafka\"}",
          "legendFormat": "Kafka RAM"
        }
      ]
    }
  ]
}
